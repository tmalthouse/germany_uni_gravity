# Copy to .env (gitignored) and fill in. The Makefile reads it.

# XYZ tile URL for the student map's historic base map: N. G. Huntington's map
# of Europe (1836, British Library) on Old Maps Online. Replace <your-key> with
# the map key from your Old Maps Online account. Leave unset to use CARTO.
HISTORIC_BASEMAP_URL=https://wmts.oldmapsonline.org/maps/56d2456f-fa2c-566c-afcd-c23310bc73f2/2023-01-17T13:32:15.669Z/{z}/{x}/{y}.png?key=<your-key>
