@article{repec:cup:jechis:v:82:y:2022:i:4:p:1071-1107_5,
	journal = {The Journal of Economic History},
	author = {Pfister, Ulrich},
	title = {Economic Growth in Germany, 1500â€“1850},
	year = {2022},
	month = {December},
	pages = {1071-1107},
	volume = {82},
	number = {4},
	abstract = {New data are used to construct a time series of real GDP in
	            Germany for the period 1500--1850 using an indirect output
	            estimation technique that relies on wages, prices, and sectoral
	            employment. Until the mid-seventeenth century, real GDP per
	            capita moved inversely with population. The eighteenth century
	            saw a modest rise in output per head. From the late 1810s,
	            economic growth gradually accelerated. The results shed new light
	            on the reversal of fortunes in early modern Europe and the
	            transition from a Malthusian regime to modern economic growth.},
	keywords = {},
	doi = {None},
